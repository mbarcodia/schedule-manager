# Copy this file to .env.local and fill in real values.
# See README.md "One-time setup" for exactly where each of these comes from.
#
# Only the first block is required. Everything below it is optional and
# enables one specific feature; the app runs fine without any of it.

# ---------------------------------------------------------------------------
# REQUIRED — Supabase project (Project Settings -> Data API / API Keys)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Your app's base URL. http://localhost:3000 for local development; your
# deployed URL (e.g. https://your-app.vercel.app) in production. Used to build
# booking links and OAuth redirect URLs, so it must match reality.
APP_ORIGIN=http://localhost:3000

# Note: there is no ANTHROPIC_API_KEY env var. Every user -- including you --
# adds their own Claude credential from inside the app (Settings), after
# signing up. This is deliberate: it removes any way for one account's AI
# usage to bill to someone else's key, even by accident.

# ---------------------------------------------------------------------------
# OPTIONAL — web push notifications (end-of-day check-in, weekly review)
# Generate the key pair with:  npx web-push generate-vapid-keys
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------------------------------------------------------------------------
# OPTIONAL — scheduled jobs (calendar sync, notification digests)
# Shared secret the cron routes require. Generate with: openssl rand -hex 32
# Use the SAME value here, in Vercel, and in your GitHub Actions secret --
# a mismatch makes the digests silently 401 (see CRON_SECRET_RUNBOOK.md).
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# OPTIONAL — the booking page's Google Calendar connection, so booked meetings
# appear on your real calendar and Google emails the guest an invite.
# One OAuth client per deployment; see README "Enabling Google Calendar".
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# OPTIONAL — running the AI on a Claude Pro/Max subscription instead of an
# API key. Requires deploying the small relay in src/relay (see README
# "Connecting Claude: two options", Option B). Skip both if using an API key.
# ---------------------------------------------------------------------------
PLANNER_RELAY_URL=
PLANNER_RELAY_SECRET=

# ---------------------------------------------------------------------------
# OPTIONAL — push alert if CRON_SECRET ever drifts out of sync.
# ALERT_OWNER_USER_ID is the Supabase auth user id that receives the alert.
# ---------------------------------------------------------------------------
ALERT_SECRET=
ALERT_OWNER_USER_ID=

# Optional, local development only: a Supabase CLI access token for
# `npm run migrate`. Without it the CLI falls back to your OS keychain, which
# on macOS raises a GUI prompt that a non-interactive shell cannot answer, so
# the push hangs with no output. Create one at
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
