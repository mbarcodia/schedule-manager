# Planner subscription-token relay — runs the Claude Agent SDK (and its
# bundled CLI binary, ~250-270MB) outside Vercel's serverless function size
# limit. Deployed to Fly.io, separate from the Next.js app on Vercel.
#
# node_modules is excluded from the Docker build context (.dockerignore) so
# `npm ci` here resolves this container's OWN platform-specific Agent SDK
# binary package (e.g. -linux-x64) rather than copying in whatever platform
# binary happens to be installed on the machine that built this image.

FROM node:22-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json ./
COPY src ./src

# Precompile to a single bundle: `npx tsx` took ~10s to start listening on a
# shared-cpu-1x, which lost the race against Fly's ~8s proxy wait when a
# scale-to-zero machine cold-started — the proxy gave up two seconds before
# the server bound, and the planner turn bounced. A prebuilt bundle loads in
# well under a second. The Agent SDK stays external (it spawns its bundled
# CLI binary from node_modules at runtime), which is why the bundle must run
# from /app where node_modules lives.
RUN npx esbuild src/relay/server.ts --bundle --platform=node --format=cjs \
  --external:@anthropic-ai/claude-agent-sdk \
  --outfile=dist-relay/relay.js

EXPOSE 8080
CMD ["node", "dist-relay/relay.js"]
