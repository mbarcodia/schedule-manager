# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# database snapshots from `npm run backup`.
#
# Ignored before the script that writes them existed, deliberately. A snapshot is
# the full plaintext contents of every note, to-do, project and event in the
# database — and this repo is a public self-host template. One `git add -A` on an
# un-ignored backup directory publishes somebody's entire schedule to GitHub, and
# a force-push does not un-publish it.
/backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
dist-relay/
